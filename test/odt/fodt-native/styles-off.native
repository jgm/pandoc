[ Header
    1
    ( "plain-heading" , [] , [] )
    [ Str "Plain" , Space , Str "Heading" ]
, Header
    1
    ( "custom-title" , [] , [] )
    [ Str "Custom" , Space , Str "Title" ]
, Para [ Str "Standard" , Space , Str "paragraph." ]
, Para [ Str "Body" , Space , Str "text." ]
, Para
    [ Strong
        [ Str "Bold" , Space , Str "body" , Space , Str "text." ]
    ]
, Para
    [ Emph
        [ Str "A"
        , Space
        , Str "Bird"
        , Space
        , Str "came"
        , Space
        , Str "down"
        , Space
        , Str "the"
        , Space
        , Str "Walk"
        ]
    ]
, Para
    [ Str "Some"
    , Space
    , Str "keyword,"
    , Space
    , Emph [ Str "emphatic" ]
    , Str ","
    , Space
    , Strong [ Str "bold" ]
    , Space
    , Str "and"
    , Space
    , Code ( "" , [] , [] ) "code"
    , Space
    , Str "text."
    ]
, Para
    [ Str "An"
    , Space
    , Emph [ Str "emphasized" ]
    , Space
    , Str "word."
    ]
, CodeBlock ( "" , [] , [] ) "code line 1\ncode line 2"
, OrderedList
    ( 1 , DefaultStyle , DefaultDelim )
    [ [ Plain [ Str "item" , Space , Str "one" ] ]
    , [ Plain [ Str "item" , Space , Str "two" ] ]
    ]
, Table
    ( "" , [] , [] )
    (Caption Nothing [])
    [ ( AlignDefault , ColWidthDefault )
    , ( AlignDefault , ColWidthDefault )
    ]
    (TableHead ( "" , [] , [] ) [])
    [ TableBody
        ( "" , [] , [] )
        (RowHeadColumns 0)
        []
        [ Row
            ( "" , [] , [] )
            [ Cell
                ( "" , [] , [] )
                AlignDefault
                (RowSpan 1)
                (ColSpan 1)
                [ Plain [ Str "cell" ] ]
            , Cell
                ( "" , [] , [] )
                AlignDefault
                (RowSpan 1)
                (ColSpan 1)
                [ Plain [ Emph [ Str "poem" ] ] ]
            ]
        ]
    ]
    (TableFoot ( "" , [] , [] ) [])
]
