Pandoc
  Meta { unMeta = fromList [] }
  [ Para
      [ Str "Here"
      , Space
      , Str "is"
      , Space
      , Str "a"
      , Space
      , Span
          ( "" , [ "deletion" ] , [ ( "author" , "Author" ) ] )
          [ Str "dummy" ]
      , Span
          ( "" , [ "insertion" ] , [ ( "author" , "Author" ) ] )
          [ Str "test" ]
      , Space
      , Span
          ( ""
          , [ "comment-start" ]
          , [ ( "comment-id" , "3" ) , ( "author" , "Author" ) ]
          )
          [ Str "With" , Space , Str "a" , Space , Str "comment!" ]
      , Str "document"
      , Span
          ( "" , [ "comment-end" ] , [ ( "comment-id" , "3" ) ] ) []
      , Str "."
      ]
  ]
