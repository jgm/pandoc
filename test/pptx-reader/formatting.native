      , Space
      , Link
          ( "" , [] , [] )
          [ Str "the" , Space , Str "report" ]
          ( "Report%20draft.pdf" , "" )
      , Str "."
      ]
  , Para [ Str "Next" , Space , Str "slide" ]
  ]
