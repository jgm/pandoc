Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "title"
            , MetaInlines [ Str "Book" , Space , Str "title" ]
            )
          , ( "abstract"
            , MetaBlocks
                [ Para [ Str "Book" , Space , Str "annotation" ]
                , Para
                    [ Str "Second"
                    , Space
                    , Str "paragraph"
                    , Space
                    , Str "of"
                    , Space
                    , Str "book"
                    , Space
                    , Str "annotation"
                    ]
                ]
            )
          , ( "keywords"
            , MetaList
                [ MetaString "foo"
                , MetaString "bar"
                , MetaString "baz"
                ]
            )
          , ( "date" , MetaInlines [ Str "2018" ] )
          , ( "author"
            , MetaList
                [ MetaInlines
                    [ Str "First"
                    , Space
                    , Str "Middle"
                    , Space
                    , Str "Last"
                    ]
                , MetaInlines [ Str "Another" , Space , Str "Author" ]
                ]
            )
          ]
    }
  [ Header
      1 ( "" , [] , [] ) [ Str "Body" , Space , Str "title" ]
  ]
